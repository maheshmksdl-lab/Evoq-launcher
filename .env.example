# Neon (or any Postgres) connection string. Server-side only.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# 32+ random characters used to sign login sessions: same command as above
SESSION_SECRET=
