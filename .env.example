# Copy to .env.local for local development. Never commit real values.

# Sign-in secrets: long random strings, different for each realm.
BETTER_AUTH_SECRET=
ADMIN_AUTH_SECRET=
# Public URL of the launcher (e.g. https://launcher.evoq.one). Optional locally.
BETTER_AUTH_URL=

# One-time token for creating the first Super Admin at /admin/setup?token=...
ADMIN_SETUP_TOKEN=

# Postgres (Neon). Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Email (Resend). Leave empty locally: emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=

# Encrypts users' saved app logins. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this makes existing saved logins unreadable.
SAVED_LOGIN_KEY=

# --- Local development only (ignored when NODE_ENV=production) ---
# Lets admins sign in without a two-factor code.
DEV_ADMIN_MFA_OPTIONAL=
# Creates superadmin@evoq.test, manager@evoq.test and asha@evoq.test on server start,
# all with the password below. Never set these on a deployment.
DEV_SEED_TEST_ACCOUNTS=
DEV_TEST_PASSWORD=
