# Copy to .env.local for local development. Never commit real values.

# Sign-in secrets: long random strings, different for each realm.
BETTER_AUTH_SECRET=
ADMIN_AUTH_SECRET=
# Public URL of the launcher (e.g. https://launcher.evoq.one). Optional locally.
BETTER_AUTH_URL=

# One-time token for creating the first Super Admin at /admin/setup?token=...
ADMIN_SETUP_TOKEN=

# Postgres (Neon). Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Email (Resend). Leave empty locally: emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=
